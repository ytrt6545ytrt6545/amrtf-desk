{
  "name": "amrtf-desk",
  "version": "1.1.0",
  "description": "大慈恩官網 (AMRTF) 獨立雙視窗播控艙",
  "main": "server.mjs",
  "type": "module",
  "bin": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "test": "node scripts/audit-signals.mjs && node --test --test-concurrency=1 test/*.test.mjs",
    "audit": "node scripts/audit-signals.mjs",
    "build": "npx @yao-pkg/pkg server.mjs --targets node20-win-x64 --output dist/AMRTF-Desk.exe",
    "package:portable": "node scripts/build-portable.mjs"
  },
  "pkg": {
    "assets": [
      "src/**/*"
    ]
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
